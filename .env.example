# ============================================================
# Policrafters CMS - Environment example
# ============================================================

DJANGO_SETTINGS_MODULE=policrafters_cms.settings.production

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=policrafters_cms
DB_USER=policrafters_cms_user
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432

# Django
SECRET_KEY=CHANGE_ME

# Hosts
ALLOWED_HOSTS=cms.policrafters.com

# CSRF
CSRF_TRUSTED_ORIGINS=https://cms.policrafters.com

# Frontend allowed to consume CMS/API
CORS_ALLOWED_ORIGINS=https://policrafters.com,https://www.policrafters.com

# Wagtail
WAGTAILADMIN_BASE_URL=https://cms.policrafters.com